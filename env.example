# Copy this file to ".env" (remove ".example") and fill in your real values.
# Never commit the real ".env" file to GitHub.

# --- Phase 1 ---
GEMINI_API_KEY=your_api_key_here

# --- Phase 3: GitHub App ---
GITHUB_APP_ID=your_app_id_here
GITHUB_WEBHOOK_SECRET=the_webhook_secret_you_created
GITHUB_PRIVATE_KEY_PATH=./your-app-name.private-key.pem

# --- Phase 4: MySQL ---
# Format: mysql+pymysql://<username>:<password>@<host>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/code_review_platform

# The "Webhook secret" you set when creating the GitHub App (Phase 2)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
